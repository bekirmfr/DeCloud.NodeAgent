# =============================================================================
# SYSTEM INFORMATION
# =============================================================================

def get_machine_id() -> str:
    """Get machine ID from /etc/machine-id"""
    try:
        if os.path.exists('/etc/machine-id'):
            with open('/etc/machine-id', 'r') as f:
                machine_id = f.read().strip()
                if machine_id:
                    return machine_id

        log_error("Could not read /etc/machine-id")
        sys.exit(1)
    except Exception as e:
        log_error(f"Failed to get machine ID: {e}")
        sys.exit(1)

# =============================================================================
# CREDENTIALS
# =============================================================================

def load_credentials() -> Optional[Dict[str, str]]:
    """Load saved credentials to check if already registered"""
    if not os.path.exists(CREDENTIALS_FILE):
        return None

    credentials = {}
    with open(CREDENTIALS_FILE, 'r') as f:
        for line in f:
            if '=' in line:
                key, value = line.strip().split('=', 1)
                credentials[key] = value

    return credentials if credentials else None

# =============================================================================
# TERMS OF SERVICE
# =============================================================================

def fetch_current_tos(orchestrator_url: str) -> Dict[str, str]:
    """
    Fetch the Terms of Service currently in effect.

    GET /api/tos is public (no auth) and returns the version, the SHA-256 of the
    document's exact bytes, and the full text.

    Fetched fresh on every run and never cached to disk: the operator must sign
    the terms actually in effect right now. A cached copy would mean signing terms
    they were not shown — which is the one way this whole flow could quietly become
    a lie.

    Fails closed. No terms => no declaration => no registration. An operator must
    never be able to register by being offline.
    """
    url = f"{orchestrator_url.rstrip('/')}/api/tos"

    try:
        response = requests.get(url, timeout=15)
        response.raise_for_status()
        payload = response.json()
    except Exception as e:
        log_error(f"Could not fetch the Terms of Service from {url}")
        log_error(f"  {e}")
        log_error("Registration cannot proceed without the terms in effect.")
        sys.exit(1)

    # TosController wraps in ApiResponse ({ success, data }); tolerate a bare object.
    data = payload.get('data') or payload

    version = (data.get('version') or '').strip()
    tos_hash = (data.get('hash') or '').strip()
    text = data.get('text') or ''

    if not version or not tos_hash or not text.strip():
        log_error("The orchestrator returned incomplete Terms of Service.")
        log_error("This is a server-side problem — report it; do not work around it.")
        sys.exit(1)

    return {'version': version, 'hash': tos_hash, 'text': text}


def display_and_accept_tos(tos: Dict[str, str]) -> bool:
    """
    Show the terms and require an explicit, typed acceptance.

    The operator is about to sign a statement that they accept these terms, so they
    must be able to read them first — that is the entire point. Printing the full
    text is what makes the signature mean something rather than being a formality.

    Requires typing 'accept': not a bare Enter, not a default-yes prompt. Anything
    else aborts. There is deliberately no --accept-tos flag; adding one is a
    decision to make on its own, in daylight.
    """
    print()
    print(f"{Colors.BOLD}{'='*70}{Colors.NC}")
    print(f"{Colors.BOLD}  DeCloud Terms of Service — version {tos['version']}{Colors.NC}")
    print(f"{Colors.BOLD}{'='*70}{Colors.NC}")
    print()
    print(tos['text'])
    print()
    print(f"{Colors.BOLD}{'='*70}{Colors.NC}")
    print(f"  Version:  {tos['version']}")
    print(f"  SHA-256:  {tos['hash']}")
    print(f"{Colors.BOLD}{'='*70}{Colors.NC}")
    print()
    print("Registering a node means hosting other people's workloads. The message")
    print("you are about to sign records that you accept these exact terms — the")
    print("hash above pins the document byte-for-byte.")
    print()

    answer = input(f"  {Colors.BOLD}Type 'accept' to accept these terms:{Colors.NC} ").strip().lower()
    print()

    if answer != 'accept':
        log_error("Terms not accepted — registration aborted.")
        log_info("Nothing was written. Re-run 'decloud register' when ready.")
        return False

    log_success(f"Terms of Service {tos['version']} accepted")
    return True

# =============================================================================
# CANONICAL SIGNING MESSAGE
# =============================================================================

def create_signing_message(machine_id: str, wallet_address: str,
                           tos: Dict[str, str]) -> str:
    """
    Create the canonical node declaration for wallet signing.

    The message format is defined in NODE-LIFECYCLE.md section 2 (decloud register).

    It declares two things, in one signature, because they are one act:
      - Locality. Country and region carry jurisdictional trust meaning; the
        signature attests to the operator's locality claim.
      - Terms of Service. Registering a node means hosting other people's
        workloads, so the operator must be bound by the terms. Rather than make
        them sign a second time in the web app, the declaration names the terms:
        version AND the SHA-256 of the document's exact bytes.

    Both ToS lines are required. The version is a label; the hash is the
    commitment. The orchestrator matches both against the terms currently in
    effect, so a declaration signed against superseded terms fails closed — the
    operator re-runs 'decloud register', is shown the new terms, and signs those.

    Timestamp uses ISO 8601 UTC. The orchestrator enforces a 5-minute
    validity window with +/-2-minute skew tolerance.
    """
    timestamp = datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')

    # Read country and region from settings JSON — the SAME source and the SAME
    # defaults the node agent uses when it builds the registration request
    # (NodeMetadataService: country ?? "ZZ", region ?? "default"). The orchestrator
    # rejects a registration whose request fields disagree with this signed text,
    # so a default mismatch here is a registration failure, not a cosmetic
    # difference. 'unknown' was used here historically and never matched the
    # agent's 'default' — harmless only because nothing compared them.
    country = _read_locality_field('country') or 'ZZ'
    region = _read_locality_field('region') or 'default'

    message = f"""DeCloud Node Declaration

Country:    {country}
Region:     {region}
Machine ID: {machine_id}
Wallet:     {wallet_address}
Terms of Service version: {tos['version']}
Terms of Service hash: {tos['hash']}
Timestamp:  {timestamp}

This signature attests that the operator of this wallet declares
the above DeCloud node to be located in the stated country and
network region, and that the operator has read and accepts the
DeCloud Terms of Service identified above. The orchestrator will
use this declaration for jurisdictional placement of tenant
workloads."""

    return message


def _read_locality_field(field: str) -> Optional[str]:
    """
    Read a locality field from settings.json.

    Returns the value for the given field, or None if not found.
    """
    settings_file = '/etc/decloud/settings.json'
    if not os.path.exists(settings_file):
        return None

    try:
        with open(settings_file, 'r') as f:
            settings = json.load(f)
        return settings.get(field)
    except Exception:
        return None

def _read_orchestrator_url() -> Optional[str]:
    """
    Read the orchestrator URL this node agent is actually configured to talk to.

    install.sh writes it here; uninstall.sh reads the same file to find the
    orchestrator on the way out. Using it means `decloud register` fetches the
    terms from — and signs the terms of — the orchestrator this node will
    actually register with. A URL from anywhere else risks the operator reading
    orchestrator A's terms and registering with orchestrator B, which B refuses
    on a hash mismatch (fail-closed, but a baffling error).

    Returns None if the file is missing or malformed; the caller decides.
    """
    settings_file = '/opt/decloud/publish/appsettings.Production.json'
    if not os.path.exists(settings_file):
        return None

    try:
        with open(settings_file, 'r') as f:
            settings = json.load(f)
        url = (settings.get('OrchestratorClient') or {}).get('BaseUrl')
        return url.strip() if url and url.strip() else None
    except Exception:
        return None


def resolve_orchestrator_url(explicit: Optional[str]) -> Tuple[str, str]:
    """
    Decide which orchestrator to talk to, and say where the answer came from.

    Order — most specific first:
      1. --orchestrator          the operator said so explicitly
      2. appsettings             what this node is actually configured with
      3. DEFAULT_ORCHESTRATOR_URL  the built-in fallback

    Returns (url, source) and the caller PRINTS the source. That matters: the
    operator is about to read and accept whatever terms this URL serves. Showing
    which orchestrator — and why that one — is the difference between an informed
    signature and a click-through.
    """
    if explicit and explicit.strip():
        return explicit.strip().rstrip('/'), 'the --orchestrator flag'

    from_settings = _read_orchestrator_url()
    if from_settings:
        return from_settings.rstrip('/'), '/opt/decloud/publish/appsettings.Production.json'

    return DEFAULT_ORCHESTRATOR_URL.rstrip('/'), 'the built-in default'

# =============================================================================
# SIGNING URL AND QR CODE
# =============================================================================

def generate_signing_url(message: str, wallet_address: str) -> str:
    """
    Generate URL to signing page with parameters.

    Format: https://decloud.stackfi.tech/sign.html?message=base64&wallet=0x...
    """
    message_b64 = base64.b64encode(message.encode()).decode()

    params = {
        'message': message_b64,
        'wallet': wallet_address
    }

    url = f"{SIGNING_PAGE_URL}?{urllib.parse.urlencode(params)}"
    return url

def display_qr_code(data: str, title: str = "Scan to sign"):
    """Display QR code in terminal"""
    qr = qrcode.QRCode(
        version=1,
        error_correction=qrcode.constants.ERROR_CORRECT_L,
        box_size=1,
        border=2,
    )
    qr.add_data(data)
    qr.make(fit=True)

    print()
    print(f"{Colors.BOLD}{Colors.CYAN}{title}{Colors.NC}")
    print()
    qr.print_ascii(invert=True)
    print()

